# Shared by apps/api and apps/worker
DATABASE_URL=postgres://sebeti:sebeti@localhost:5432/sebeti
# Keyrings: "v1:<base64 32 bytes>" (append ";v2:…" to rotate). Generate a key: openssl rand -base64 32
# Integration secrets (OAuth tokens).
ENCRYPTION_KEY=
# Wraps each organization's data key (customer names, raw webhook payloads, phone HMAC).
DATA_MASTER_KEY=
# Signs session cookies (API only).
BETTER_AUTH_SECRET=
# Nightly AI brief (worker only). Empty key: the brief keeps the raw signals, no model call.
ANTHROPIC_API_KEY=
AI_BRIEF_ENABLED=true
# Optional, defaults to claude-opus-5-5 (e.g. claude-sonnet-5-5 to halve the cost).
AI_BRIEF_MODEL=
# Public URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
PORT=4000
# Transactional e-mail (Resend). Without a key, e-mails are skipped (only the subject is logged).
RESEND_API_KEY=
EMAIL_FROM=7sebeti <no-reply@7sebeti.com>
