# Copy to ops/deploy/.env on the VM (chmod 600). Never commit the real file.
# edge = Caddy (TLS, ports 80/443), backup = nightly encrypted dump. Staging leaves both out.
COMPOSE_PROFILES=edge,backup
IMAGE_TAG=latest
API_DOMAIN=api.7sebeti.com

# App (api + worker)
# OVHcloud managed PostgreSQL: private host and port from the console, user avnadmin.
# No sslmode here: TLS is verified with the CA in ops/deploy/db-ca.pem (see compose.yml).
DATABASE_URL=postgres://avnadmin:PASSWORD@PRIVATE_HOST:PORT/sebeti
APP_URL=https://app.7sebeti.com
API_URL=https://api.7sebeti.com
PORT=4000
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=v1:
DATA_MASTER_KEY=v1:
RESEND_API_KEY=
EMAIL_FROM=7sebeti <no-reply@7sebeti.com>
# Nightly AI brief (worker only). Empty key: briefs keep the raw signals. Leave empty on staging.
ANTHROPIC_API_KEY=
AI_BRIEF_ENABLED=true
AI_BRIEF_MODEL=

# Backups (service "backup", profile "backup")
BACKUP_AGE_RECIPIENT=age1...
# OVHcloud Object Storage (bucket created with object lock)
S3_BUCKET=sebeti-backups
# Same region as the VM: eu-west-par (Paris) or gra (Gravelines)
S3_ENDPOINT=https://s3.eu-west-par.io.cloud.ovh.net
S3_REGION=eu-west-par
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
HEARTBEAT_URL=
BACKUP_AT_UTC=02:30
