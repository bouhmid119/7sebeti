# Copy to ops/deploy/.env on the VM (chmod 600). Never commit the real file.
# edge = Caddy (TLS, ports 80/443), backup = nightly encrypted dump. Staging leaves both out.
COMPOSE_PROFILES=edge,backup
IMAGE_TAG=latest
API_DOMAIN=api.7sebeti.com

# App (api + worker)
DATABASE_URL=postgres://USER:PASSWORD@PRIVATE_HOST:5432/sebeti?sslmode=require
APP_URL=https://app.7sebeti.com
API_URL=https://api.7sebeti.com
PORT=4000
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=v1:
DATA_MASTER_KEY=v1:

# Backups (service "backup", profile "backup")
BACKUP_AGE_RECIPIENT=age1...
R2_BUCKET=sebeti-backups
R2_ENDPOINT=https://ACCOUNT_ID.eu.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
HEARTBEAT_URL=
BACKUP_AT_UTC=02:30
