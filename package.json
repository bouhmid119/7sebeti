{
  "name": "7sebeti",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check . && node packages/modules/check-boundaries.mjs",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @7sebeti/db generate",
    "db:migrate": "pnpm --filter @7sebeti/db migrate",
    "check-boundaries": "node packages/modules/check-boundaries.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
